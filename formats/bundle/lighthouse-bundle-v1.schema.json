{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LighthouseRobotics/lighthouse/formats/bundle/lighthouse-bundle-v1.schema.json",
  "title": "lighthouse-bundle/v1 manifest",
  "description": "Documents the envelope fields. The verifiers in this folder are the authority; they also enforce file ordering, path portability, archive structure and limits that JSON Schema cannot express.",
  "type": "object",
  "required": ["schema", "producer", "created", "payloadSchema", "reality", "files", "omissions", "boundary"],
  "patternProperties": { "^x-": true },
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "lighthouse-bundle/v1" },
    "producer": {
      "type": "object",
      "required": ["app", "version"],
      "additionalProperties": false,
      "properties": {
        "app": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "repository": { "type": "string", "minLength": 1, "maxLength": 200 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" }
      }
    },
    "created": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$" },
    "payloadSchema": { "type": "string", "minLength": 1, "maxLength": 200 },
    "reality": { "enum": ["physical", "simulated", "synthetic", "unknown"] },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "pattern": "^payload/.*[^/]$", "maxLength": 512 },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "mediaType": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "omissions": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["what", "why"],
        "additionalProperties": false,
        "properties": {
          "what": { "type": "string", "minLength": 1, "maxLength": 500 },
          "why": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    },
    "boundary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "source": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 500 },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    }
  }
}
