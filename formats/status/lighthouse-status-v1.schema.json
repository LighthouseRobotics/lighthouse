{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LighthouseRobotics/lighthouse/blob/main/formats/status/lighthouse-status-v1.schema.json",
  "title": "lighthouse-status/v1",
  "description": "One status line per repository: STATUS.json at the repository root, read by the vault builder.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "repository", "status", "summary", "lastVerified", "verifiedBy", "nextAction", "blockers", "startHere"],
  "properties": {
    "schema": {"const": "lighthouse-status/v1"},
    "repository": {"type": "string", "pattern": "^LighthouseRobotics/[A-Za-z0-9_.-]+$"},
    "status": {"enum": ["active", "blocked", "paused", "archived"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 400},
    "lastVerified": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "verifiedBy": {"type": "string", "minLength": 1, "maxLength": 400},
    "nextAction": {"type": "string", "minLength": 1, "maxLength": 400},
    "blockers": {"type": "array", "maxItems": 10, "items": {"type": "string", "minLength": 1, "maxLength": 400}},
    "startHere": {"type": "string", "minLength": 1, "maxLength": 200}
  }
}
